# Godot 4 (commit .import and .uid files; only the cache folder is ignored)
.godot/
*.translation
/android/

# Build output
/build/
/exports/
*.apk
*.aab
*.ipa
*.dSYM/

# Signing material and secrets: never commit
*.keystore
*.jks
*.p12
*.mobileprovision
*.cer
.env
.env.*
export_credentials.cfg
# Local iOS signing and device settings (team ID, device UDID, dev bundle id): never committed (D-058)
tools/build/local.env

# Blender autosaves and backups
*.blend1
*.blend2
*.blend@

# Agent git worktrees (each code track works in its own; merged by the director)
.claude/worktrees/

# Tooling
__pycache__/
*.pyc
.DS_Store

# View close-up captures are regenerated on demand (scrubber --capture); only pose captures are committed (D-045)
captures/view/*_side.png
captures/view/*_top.png
