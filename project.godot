; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Sourdough"
config/version="0.2.0"
run/main_scene="res://src/main/main.tscn"
config/quit_on_go_back=false
config/features=PackedStringArray("4.7", "Mobile")

[audio]

general/ios/mix_with_others=true

[autoload]

Bus="*res://src/core/bus.gd"
Session="*res://src/core/game_session.gd"

[debug]

gdscript/warnings/untyped_declaration=2
gdscript/warnings/unsafe_property_access=2
gdscript/warnings/unsafe_method_access=2
gdscript/warnings/unsafe_cast=1
gdscript/warnings/unsafe_call_argument=1

[display]

window/size/viewport_width=390
window/size/viewport_height=844
window/energy_saving/keep_screen_on=false
window/handheld/orientation=1

[filesystem]

import/blender/enabled=false

[input]

dev_overlay={
"deadzone": 0.2,
"events": [Object(InputEventKey,"resource_local_to_scene":false,"resource_name":"","device":-1,"window_id":0,"alt_pressed":false,"shift_pressed":false,"ctrl_pressed":false,"meta_pressed":false,"pressed":false,"keycode":0,"physical_keycode":4194334,"key_label":0,"unicode":0,"location":0,"echo":false,"script":null)
]
}

[input_devices]

pointing/emulate_touch_from_mouse=true

[rendering]

renderer/rendering_method="mobile"
textures/vram_compression/import_etc2_astc=true
anti_aliasing/quality/msaa_3d=1
scaling_3d/scale=0.75
