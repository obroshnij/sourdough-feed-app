class_name ThemeBuilder
extends RefCounted
## Builds the one UI Theme (architecture.md §9.1, ux-design.md §17) from the palette and the text size.
## `src/ui/theme/sourdough_theme.tres` is this builder's output at 100% text by day, regenerated by
## `tests/unit/ui/tools/build_theme.gd`, and `test_theme.gd` fails if the file is stale.
## At runtime UiRoot merges a fresh build into the loaded .tres when the text size or the night blend
## changes, so every Control keeps resolving to that one resource.
##
## Every Control type the UI uses is styled here, so no default Godot look ships (AC-12.5).

const THEME_PATH: String = "res://src/ui/theme/sourdough_theme.tres"
const PALETTE_TYPE: StringName = &"Palette"

## Fully rounded: StyleBoxFlat scales radii down to fit the box.
const PILL_RADIUS: int = 100
const FOCUS_RING: int = 2
const FOCUS_GAP: int = 2
## ux-design §17 asks for 1.5 pt outlines. StyleBoxFlat borders are whole units, so they use 2.
const OUTLINE_W: int = 2

## Theme type variations, by component.
const LABEL_TYPES: Array[StringName] = [
	&"TitleLabel", &"NameLabel", &"HintLabel", &"BodyLabel", &"SectionLabel", &"ToastLabel",
	&"ReasonLabel", &"BarPopupLabel", &"ValueLabel",
]
const BUTTON_TYPES: Array[StringName] = [
	&"PrimaryButton", &"SecondaryButton", &"TextButton", &"IconButton", &"ChipButton",
	&"ActionBarButton", &"ActionBarButtonLocked", &"StatusPill", &"ToggleRow", &"StepButton",
]
const PANEL_TYPES: Array[StringName] = [
	&"HudPlate", &"BarPlate", &"SheetPanel", &"CardPanel", &"ToastPanel", &"PopupPlate",
]


static func build(palette: UiPalette, text_scale: float) -> Theme:
	var t := Theme.new()
	var regular: FontVariation = UiFonts.figtree(UiFonts.WEIGHT_REGULAR)
	var semibold: FontVariation = UiFonts.figtree(UiFonts.WEIGHT_SEMIBOLD)
	var display: FontVariation = UiFonts.fraunces(UiFonts.WEIGHT_SEMIBOLD)
	var title: int = TypeScale.size(TypeScale.Role.TITLE, text_scale)
	var button: int = TypeScale.size(TypeScale.Role.BUTTON, text_scale)
	var body: int = TypeScale.size(TypeScale.Role.BODY, text_scale)
	var bar: int = TypeScale.size(TypeScale.Role.BAR_LABEL, text_scale)
	var popup: int = TypeScale.size(TypeScale.Role.BAR_POPUP, text_scale)
	t.default_font = regular
	t.default_font_size = body
	t.default_base_scale = 1.0

	_palette_colors(t, palette)
	_labels(t, palette, regular, semibold, display, title, body, popup)
	_buttons(t, palette, regular, semibold, title, button, body, bar)
	_panels(t, palette)
	_misc(t, palette, regular, button, body)
	return t


## The roles as theme colors, so components read colors from the Theme, never from constants.
static func _palette_colors(t: Theme, p: UiPalette) -> void:
	var roles: Dictionary[StringName, Color] = {
		&"surface": p.surface(), &"surface_alt": UiPalette.SURFACE_ALT, &"plate": p.plate(),
		&"ink": UiPalette.INK, &"ink_muted": UiPalette.INK_MUTED, &"accent": UiPalette.ACCENT,
		&"on_accent": UiPalette.ON_ACCENT, &"outline": UiPalette.OUTLINE, &"disabled": UiPalette.DISABLED,
		&"care_fill": UiPalette.CARE_FILL, &"scrim": p.scrim(), &"shadow": p.shadow(),
	}
	for tone_id: StringName in UiPalette.TONES:
		roles[StringName("tone_%s" % tone_id)] = UiPalette.TONES[tone_id]
	for role: StringName in roles:
		t.set_color(role, PALETTE_TYPE, roles[role])


static func _labels(t: Theme, p: UiPalette, regular: Font, semibold: Font, display: Font, title: int,
		body: int, popup: int) -> void:
	var body_gap: int = _line_gap(regular, body, TypeScale.BODY_LINE_HEIGHT)
	_label(t, &"Label", &"", regular, body, UiPalette.INK, body_gap)
	_label(t, &"TitleLabel", &"Label", semibold, title, UiPalette.INK, _line_gap(semibold, title, TypeScale.TITLE_LINE_HEIGHT))
	_label(t, &"NameLabel", &"Label", display, title, UiPalette.INK, _line_gap(display, title, TypeScale.TITLE_LINE_HEIGHT))
	_label(t, &"HintLabel", &"Label", regular, body, UiPalette.INK_MUTED, body_gap)
	_label(t, &"BodyLabel", &"Label", regular, body, UiPalette.INK, body_gap)
	_label(t, &"SectionLabel", &"Label", semibold, body, UiPalette.INK, body_gap)
	_label(t, &"ToastLabel", &"Label", regular, body, p.surface(), body_gap)
	_label(t, &"ReasonLabel", &"Label", regular, body, UiPalette.INK_MUTED, body_gap)
	_label(t, &"BarPopupLabel", &"Label", semibold, popup, p.surface(), 0)
	_label(t, &"ValueLabel", &"Label", semibold, title, UiPalette.INK, 0)


static func _label(t: Theme, type: StringName, base: StringName, font: Font, size: int, color: Color,
		line_gap: int) -> void:
	if base != &"":
		t.set_type_variation(type, base)
	t.set_font(&"font", type, font)
	t.set_font_size(&"font_size", type, size)
	t.set_color(&"font_color", type, color)
	t.set_color(&"font_shadow_color", type, Color(0, 0, 0, 0))
	t.set_color(&"font_outline_color", type, Color(0, 0, 0, 0))
	t.set_constant(&"line_spacing", type, line_gap)
	t.set_constant(&"outline_size", type, 0)
	t.set_constant(&"shadow_outline_size", type, 0)


static func _buttons(t: Theme, p: UiPalette, regular: Font, semibold: Font, title: int, button: int, body: int,
		bar: int) -> void:
	var ink: Color = UiPalette.INK
	var alt: Color = UiPalette.SURFACE_ALT
	# Base Button = SecondaryButton look, so even an unstyled Button never shows the default theme.
	for type: StringName in [&"Button", &"SecondaryButton"]:
		_button_box(t, type, _flat(Color(0, 0, 0, 0), PILL_RADIUS, 20, 10, UiPalette.OUTLINE),
			_flat(alt, PILL_RADIUS, 20, 10, UiPalette.OUTLINE),
			_flat(Color(0, 0, 0, 0), PILL_RADIUS, 20, 10, UiPalette.DISABLED), PILL_RADIUS)
		_button_text(t, type, semibold, button, ink, ink, UiPalette.DISABLED)
	t.set_type_variation(&"SecondaryButton", &"Button")

	t.set_type_variation(&"PrimaryButton", &"Button")
	_button_box(t, &"PrimaryButton", _flat(UiPalette.ACCENT, PILL_RADIUS, 24, 12),
		_flat(UiPalette.pressed(UiPalette.ACCENT), PILL_RADIUS, 24, 12), _flat(alt, PILL_RADIUS, 24, 12), PILL_RADIUS)
	_button_text(t, &"PrimaryButton", semibold, button, UiPalette.ON_ACCENT, UiPalette.ON_ACCENT, UiPalette.DISABLED)

	t.set_type_variation(&"TextButton", &"Button")
	_button_box(t, &"TextButton", _empty(12, 8), _flat(alt, 12, 12, 8), _empty(12, 8), 12)
	_button_text(t, &"TextButton", semibold, button, UiPalette.INK_MUTED, ink, UiPalette.DISABLED)
	# Icons are imported at 4x (96 px); every button draws them at 24 pt.
	for type: StringName in [&"Button", &"SecondaryButton", &"PrimaryButton", &"TextButton"]:
		t.set_constant(&"icon_max_width", type, 24)

	t.set_type_variation(&"IconButton", &"Button")
	_button_box(t, &"IconButton", _flat(p.plate(), PILL_RADIUS, 12, 12), _flat(alt, PILL_RADIUS, 12, 12),
		_flat(p.plate(), PILL_RADIUS, 12, 12), PILL_RADIUS)
	_button_text(t, &"IconButton", semibold, button, ink, ink, UiPalette.DISABLED)
	t.set_constant(&"icon_max_width", &"IconButton", 24)

	t.set_type_variation(&"StepButton", &"Button")
	_button_box(t, &"StepButton", _flat(Color(0, 0, 0, 0), PILL_RADIUS, 12, 12, UiPalette.OUTLINE),
		_flat(alt, PILL_RADIUS, 12, 12, UiPalette.OUTLINE), _flat(Color(0, 0, 0, 0), PILL_RADIUS, 12, 12, UiPalette.DISABLED),
		PILL_RADIUS)
	_button_text(t, &"StepButton", semibold, button, ink, ink, UiPalette.DISABLED)

	t.set_type_variation(&"ChipButton", &"Button")
	var chip_rest: StyleBoxFlat = _flat(alt, PILL_RADIUS, 16, 10, UiPalette.OUTLINE)
	var chip_on: StyleBoxFlat = _flat(UiPalette.ACCENT, PILL_RADIUS, 16, 10, UiPalette.ACCENT)
	_button_box(t, &"ChipButton", chip_rest, _flat(UiPalette.pressed(alt), PILL_RADIUS, 16, 10, UiPalette.OUTLINE),
		_flat(alt, PILL_RADIUS, 16, 10, UiPalette.DISABLED), PILL_RADIUS)
	# A toggled chip uses the pressed slot: accent fill, on_accent label, check icon (component).
	t.set_stylebox(&"pressed", &"ChipButton", chip_on)
	t.set_stylebox(&"hover_pressed", &"ChipButton", chip_on)
	_button_text(t, &"ChipButton", semibold, body, ink, UiPalette.ON_ACCENT, UiPalette.DISABLED)
	t.set_constant(&"icon_max_width", &"ChipButton", 20)

	for type: StringName in [&"ActionBarButton", &"ActionBarButtonLocked"]:
		t.set_type_variation(type, &"Button")
		_button_box(t, type, _empty(2, 6), _flat(alt, 20, 2, 6), _empty(2, 6), 20)
		t.set_constant(&"icon_max_width", type, 28)
		t.set_constant(&"h_separation", type, 4)
	_button_text(t, &"ActionBarButton", semibold, bar, ink, ink, UiPalette.DISABLED)
	_button_text(t, &"ActionBarButtonLocked", semibold, bar, UiPalette.DISABLED, UiPalette.DISABLED, UiPalette.DISABLED)

	t.set_type_variation(&"StatusPill", &"Button")
	var pill: StyleBoxFlat = _flat(alt, PILL_RADIUS, 10, 6, UiPalette.OUTLINE)
	_button_box(t, &"StatusPill", pill, _flat(UiPalette.pressed(alt), PILL_RADIUS, 10, 6, UiPalette.OUTLINE), pill, PILL_RADIUS)
	_button_text(t, &"StatusPill", semibold, button, ink, ink, ink)
	t.set_constant(&"icon_max_width", &"StatusPill", 24)
	t.set_constant(&"h_separation", &"StatusPill", 8)

	# OptionRow / OptionCard: surface_alt; selected adds a 3 pt accent border (the component adds the check).
	t.set_type_variation(&"ChoiceButton", &"Button")
	var choice_on: StyleBoxFlat = _flat(alt, 16, 0, 0)
	choice_on.border_color = UiPalette.ACCENT
	choice_on.set_border_width_all(3)
	_button_box(t, &"ChoiceButton", _flat(alt, 16, 0, 0), _flat(UiPalette.pressed(alt), 16, 0, 0), _flat(alt, 16, 0, 0), 16)
	t.set_stylebox(&"pressed", &"ChoiceButton", choice_on)
	t.set_stylebox(&"hover_pressed", &"ChoiceButton", choice_on)
	t.set_stylebox(&"pressed_mirrored", &"ChoiceButton", choice_on)
	t.set_stylebox(&"hover_pressed_mirrored", &"ChoiceButton", choice_on)
	_button_text(t, &"ChoiceButton", semibold, button, ink, ink, UiPalette.DISABLED)
	t.set_font(&"title_font", &"ChoiceButton", semibold)
	t.set_font_size(&"title_size", &"ChoiceButton", button)
	t.set_font(&"sub_font", &"ChoiceButton", regular)
	t.set_font_size(&"sub_size", &"ChoiceButton", body)

	t.set_type_variation(&"ToggleRow", &"Button")
	# Right margin leaves room for the 51 x 31 switch the component draws.
	var row: StyleBox = _empty(4, 10)
	row.content_margin_right = 16 + 51 + 8
	var row_down: StyleBoxFlat = _flat(alt, 12, 4, 10)
	row_down.content_margin_right = row.content_margin_right
	_button_box(t, &"ToggleRow", row, row_down, row, 12)
	t.set_stylebox(&"pressed", &"ToggleRow", row)
	t.set_stylebox(&"hover_pressed", &"ToggleRow", row)
	_button_text(t, &"ToggleRow", regular, body, ink, ink, UiPalette.DISABLED)
	t.set_constant(&"line_spacing", &"ToggleRow", _line_gap(regular, body, TypeScale.BODY_LINE_HEIGHT))
	var _unused: int = title


static func _button_box(t: Theme, type: StringName, normal: StyleBox, down: StyleBox, disabled: StyleBox,
		radius: int) -> void:
	t.set_stylebox(&"normal", type, normal)
	t.set_stylebox(&"hover", type, normal)
	t.set_stylebox(&"pressed", type, down)
	t.set_stylebox(&"hover_pressed", type, down)
	t.set_stylebox(&"disabled", type, disabled)
	t.set_stylebox(&"focus", type, _focus_ring(radius))
	for suffix: String in ["_mirrored"]:
		for state: String in ["normal", "hover", "pressed", "hover_pressed", "disabled"]:
			t.set_stylebox(StringName(state + suffix), type, t.get_stylebox(StringName(state), type))


static func _button_text(t: Theme, type: StringName, font: Font, size: int, normal: Color, down: Color,
		disabled: Color) -> void:
	t.set_font(&"font", type, font)
	t.set_font_size(&"font_size", type, size)
	for name: StringName in [&"font_color", &"font_hover_color", &"font_focus_color"]:
		t.set_color(name, type, normal)
	for name: StringName in [&"font_pressed_color", &"font_hover_pressed_color"]:
		t.set_color(name, type, down)
	t.set_color(&"font_disabled_color", type, disabled)
	t.set_color(&"font_outline_color", type, Color(0, 0, 0, 0))
	for name: StringName in [&"icon_normal_color", &"icon_hover_color", &"icon_focus_color"]:
		t.set_color(name, type, normal)
	for name: StringName in [&"icon_pressed_color", &"icon_hover_pressed_color"]:
		t.set_color(name, type, down)
	t.set_color(&"icon_disabled_color", type, disabled)
	t.set_constant(&"outline_size", type, 0)
	t.set_constant(&"h_separation", type, t.get_constant(&"h_separation", type) if t.has_constant(&"h_separation", type) else 8)


static func _panels(t: Theme, p: UiPalette) -> void:
	var surface: Color = p.surface()
	for type: StringName in [&"PanelContainer", &"Panel"]:
		t.set_stylebox(&"panel", type, _flat(surface, 20, 0, 0))
	var plate: StyleBoxFlat = _flat(p.plate(), 24, 16, 12)
	_panel(t, &"HudPlate", plate)
	# No vertical padding: the five buttons are the 72 pt slots themselves (ux-design §4).
	_panel(t, &"BarPlate", _flat(p.plate(), 28, 4, 0))
	var sheet: StyleBoxFlat = _flat(surface, 24, 20, 8)
	sheet.corner_radius_bottom_left = 0
	sheet.corner_radius_bottom_right = 0
	sheet.content_margin_bottom = 0
	_panel(t, &"SheetPanel", sheet)
	var card: StyleBoxFlat = _flat(surface, 20, 20, 20)
	card.shadow_color = p.shadow()
	card.shadow_size = 24
	card.shadow_offset = Vector2(0, 8)
	_panel(t, &"CardPanel", card)
	_panel(t, &"ToastPanel", _flat(UiPalette.INK, 16, 16, 12))
	_panel(t, &"PopupPlate", _flat(UiPalette.INK, 16, 16, 10))


static func _panel(t: Theme, type: StringName, box: StyleBox) -> void:
	t.set_type_variation(type, &"PanelContainer")
	t.set_stylebox(&"panel", type, box)


static func _misc(t: Theme, p: UiPalette, regular: Font, button: int, body: int) -> void:
	# Scrolling: a thin outline grabber, no track.
	for type: StringName in [&"VScrollBar", &"HScrollBar"]:
		var track := StyleBoxEmpty.new()
		track.set_content_margin_all(3)
		t.set_stylebox(&"scroll", type, track)
		t.set_stylebox(&"scroll_focus", type, track)
		var grab: StyleBoxFlat = _flat(Color(UiPalette.OUTLINE, 0.5), 3, 3, 3)
		for name: StringName in [&"grabber", &"grabber_highlight", &"grabber_pressed"]:
			t.set_stylebox(name, type, grab)
	t.set_stylebox(&"panel", &"ScrollContainer", StyleBoxEmpty.new())
	t.set_stylebox(&"focus", &"ScrollContainer", StyleBoxEmpty.new())
	# Text field (naming, Phase 3): outline 2, ink 17, focus ring.
	var field: StyleBoxFlat = _flat(p.surface(), 14, 16, 12, UiPalette.OUTLINE)
	t.set_stylebox(&"normal", &"LineEdit", field)
	t.set_stylebox(&"read_only", &"LineEdit", field)
	t.set_stylebox(&"focus", &"LineEdit", _focus_ring(14))
	t.set_font(&"font", &"LineEdit", regular)
	t.set_font_size(&"font_size", &"LineEdit", button)
	t.set_color(&"font_color", &"LineEdit", UiPalette.INK)
	t.set_color(&"font_placeholder_color", &"LineEdit", UiPalette.INK_MUTED)
	t.set_color(&"caret_color", &"LineEdit", UiPalette.INK)
	t.set_color(&"selection_color", &"LineEdit", Color(UiPalette.ACCENT, 0.3))
	t.set_color(&"font_selected_color", &"LineEdit", UiPalette.INK)
	# Tooltips are not used, but never default.
	t.set_stylebox(&"panel", &"TooltipPanel", _flat(UiPalette.INK, 12, 12, 8))
	t.set_font_size(&"font_size", &"TooltipLabel", body)
	t.set_color(&"font_color", &"TooltipLabel", p.surface())
	var line := StyleBoxLine.new()
	line.color = UiPalette.SURFACE_ALT
	line.thickness = 1
	t.set_stylebox(&"separator", &"HSeparator", line)
	t.set_constant(&"separation", &"HSeparator", 1)
	t.set_constant(&"separation", &"VBoxContainer", 8)
	t.set_constant(&"separation", &"HBoxContainer", 8)


static func _flat(bg: Color, radius: int, pad_h: int, pad_v: int, border: Color = Color(0, 0, 0, 0)) -> StyleBoxFlat:
	var s := StyleBoxFlat.new()
	s.bg_color = bg
	s.set_corner_radius_all(radius)
	s.corner_detail = 12
	s.anti_aliasing = true
	s.content_margin_left = pad_h
	s.content_margin_right = pad_h
	s.content_margin_top = pad_v
	s.content_margin_bottom = pad_v
	if border.a > 0.0:
		s.border_color = border
		s.set_border_width_all(OUTLINE_W)
	return s


static func _empty(pad_h: int, pad_v: int) -> StyleBoxEmpty:
	var s := StyleBoxEmpty.new()
	s.content_margin_left = pad_h
	s.content_margin_right = pad_h
	s.content_margin_top = pad_v
	s.content_margin_bottom = pad_v
	return s


## ux-design §17 focus: a 2 pt ink ring with a 2 pt gap, outside the control.
static func _focus_ring(radius: int) -> StyleBoxFlat:
	var s := StyleBoxFlat.new()
	s.draw_center = false
	s.border_color = UiPalette.INK
	s.set_border_width_all(FOCUS_RING)
	s.set_corner_radius_all(radius + FOCUS_RING + FOCUS_GAP)
	s.set_expand_margin_all(FOCUS_RING + FOCUS_GAP)
	s.corner_detail = 12
	s.anti_aliasing = true
	return s


## Extra pixels between lines so the line height is `ratio` times the font size.
static func _line_gap(font: Font, size: int, ratio: float) -> int:
	var natural: float = font.get_height(size)
	return maxi(roundi(size * ratio - natural), 0)
