; Base project for each runner self-test case (tests/run.sh --selftest).
; The warning levels mirror architecture.md §13, so the cases see the real typing rules.

config_version=5

[application]

config/name="sourdough_runner_selftest"
config/use_custom_user_dir=true
config/custom_user_dir_name="sourdough_runner_selftest"

[debug]

gdscript/warnings/untyped_declaration=2
gdscript/warnings/unsafe_property_access=2
gdscript/warnings/unsafe_method_access=2
gdscript/warnings/unsafe_call_argument=1
gdscript/warnings/unsafe_cast=1
gdscript/warnings/inferred_declaration=0
